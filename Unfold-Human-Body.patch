 public/human-body-credits.txt     |  20 +++
 src/lessons.js                    |   1 +
 src/main.js                       |   7 +-
 src/models/assets/human-body.glb  | Bin 0 -> 1723472 bytes
 src/models/assets/human-body.json |   1 +
 src/models/body.js                | 224 ++++++++++++------------------
 src/style.css                     |   5 +-
